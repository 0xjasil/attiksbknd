datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EDITOR
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum ProjectStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

model Project {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  category    String
  location    String
  year        String
  image       String
  imageAlt    String?       @default("")
  galleryAlts String[]      @default([])
  description String
  highlights  String[]      @default([])
  gallery     String[]      @default([])
  scope       String?
  area        String?
  status      ProjectStatus @default(PUBLISHED)
  featured    Boolean       @default(false)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  leads       Lead[]

  @@index([slug])
  @@index([status, order])
  @@index([category])
  @@map("projects")
}

model Lead {
  id           String     @id @default(uuid())
  name         String
  email        String
  phone        String?
  message      String?
  projectTitle String?
  projectId    String?
  status       LeadStatus @default(NEW)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@index([projectId])
  @@map("leads")
}

model Testimonial {
  id          String   @id @default(uuid())
  quote       String
  author      String
  designation String
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
  @@map("testimonials")
}

model HeroSlide {
  id          String   @id @default(uuid())
  mediaType   String   @default("video") // "video" or "image" (supports webp, gif, jpg, png, mp4, webm)
  mediaUrl    String
  posterUrl   String?
  altText     String?       @default("")
  title       String?
  subtitle    String?
  ctaText     String?  @default("view projects")
  ctaLink     String?  @default("/projects")
  order       Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
  @@map("hero_slides")
}

model HeroSettings {
  id               Int      @id @default(1)
  autoPlayInterval Int      @default(6500)
  showPagination   Boolean  @default(true)
  showCta          Boolean  @default(true)
  defaultCtaText   String   @default("view projects")
  defaultCtaLink   String   @default("/projects")
  updatedAt        DateTime @updatedAt

  @@map("hero_settings")
}

model GalleryPost {
  id          String   @id @default(uuid())
  image       String
  caption     String   @default("Architectural Highlight")
  altText     String?  @default("")
  description String?  @default("")
  location    String?  @default("")
  aspectRatio String?  @default("auto")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
  @@map("gallery_posts")
}
